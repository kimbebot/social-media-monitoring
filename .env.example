# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/social_monitor.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/social_monitor

# Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-encryption-key-here

# Scraping Configuration
MIN_DELAY=2.5
MAX_DELAY=7.0
PAGE_LOAD_TIMEOUT=30000
SCROLL_DELAY_MIN=1.5
SCROLL_DELAY_MAX=4.0

# Browser Configuration
HEADLESS=true
USER_DATA_DIR=./browser_profiles

# Proxy Configuration (optional)
USE_PROXY=false
PROXY_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/social_monitor.log

# Rate Limiting
MAX_CONCURRENT_SCRAPERS=2
SCRAPE_INTERVAL_MINUTES=180

# Platform-specific settings
LINKEDIN_ENABLED=true
FACEBOOK_ENABLED=true
TWITTER_ENABLED=true
